# Cyber Threat Dashboard
threats = [
    {"type": "Phishing", "source": "Email", "severity": "High"},
    {"type": "Malware", "source": "Download", "severity": "Critical"},
    {"type": "Brute Force", "source": "Login", "severity": "Medium"},
    {"type": "Phishing", "source": "Website", "severity": "High"},
    {"type": "Suspicious Login", "source": "Network", "severity": "Low"}
]
print("=" * 50)
print("           CYBER THREAT DASHBOARD")
print("=" * 50)
print("\nThreat Details:")
print("-" * 50)
for threat in threats:
    print("Threat   :", threat["type"])
    print("Source   :", threat["source"])
    print("Severity :", threat["severity"])
    print("-" * 50)
# Count threats
total = len(threats)
high = sum(1 for t in threats if t["severity"] == "High")
critical = sum(1 for t in threats if t["severity"] == "Critical")
medium = sum(1 for t in threats if t["severity"] == "Medium")
low = sum(1 for t in threats if t["severity"] == "Low")
print("\nDashboard Summary")
print("=" * 30)
print("Total Threats :", total)
print("Critical      :", critical)
print("High          :", high)
print("Medium        :", medium)
print("Low           :", low)
print("=" * 30)
print("Dashboard completed successfully.")

